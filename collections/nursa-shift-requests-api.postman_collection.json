        {
          "id": "91cf3296-7168-46fe-b7a8-cf7c124cf16b",
          "name": "Reject clinicians shift request",
          "request": {
            "name": "Reject clinicians shift request",
            "description": {
              "content": "<h3><strong>Reject a Clinician's Shift Request</strong></h3>\n<p>This operation rejects a clinician's request to take a shift.</p>\n<h4><strong>Notifications</strong></h4>\n<ul>\n<li>The clinician whose request was rejected will be notified that the shift has already been filled.</li>\n</ul>\n<h4><strong>Shift Status Updates</strong></h4>\n<ul>\n<li>The rejected clinician will see the shift marked as <strong>&quot;Filled&quot;</strong> in their view, indicating that the shift is no longer available for them.</li>\n</ul>\n<h4><strong>Errors</strong></h4>\n<ul>\n<li><strong>409 Conflict</strong>: Returned if you attempt to reject a shift request that is not in the <strong>&quot;Requested&quot;</strong> status.\n<ul>\n<li><strong>Message:</strong> <code>Shift request can't be rejected because shift is not in Requested status.</code></li>\n</ul>\n</li>\n</ul>\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v2",
                "public",
                "shift-requests",
                "reject"
              ],
              "host": [
                "{{baseUrl}}"
