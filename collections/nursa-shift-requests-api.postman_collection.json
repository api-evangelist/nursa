          "name": "Get requested shifts",
          "request": {
            "name": "Get requested shifts",
            "description": {
              "content": "<p>Returns requested shift with clinician's details and a link to <a href=\"download-controller-clinician-profile\">download clinician profile</a> that is generated when the shift was requested. This ensures the clinician information is up to date.</p>\n<p>Users can also create a <a href=\"facilities-webhooks-controller-create-one\" target=\"_blank\">Webhook</a> in our system to receive notifications when a clinician requests to work a shift.</p>\n",
              "type": "text/plain"
            },
            "url": {
