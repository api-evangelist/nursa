        {
          "id": "36035759-cbb2-4fd2-92b5-bddbfe6f707e",
          "name": "Download Clinician Document attachment",
          "request": {
            "name": "Download Clinician Document attachment",
            "description": {
              "content": "<h3>General Information</h3>\n<p>This endpoint allows you to download a specific attachment file associated with a clinician's document.</p>\n<h4><strong>Required Parameters</strong></h4>\n<ul>\n<li><strong>clinicianId</strong> (path parameter): The unique identifier of the clinician</li>\n<li><strong>attachmentId</strong> (path parameter): The unique identifier of the specific attachment to download</li>\n</ul>\n<h4><strong>File Handling</strong></h4>\n<ul>\n<li>Files are streamed directly to the client for immediate download</li>\n</ul>\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
